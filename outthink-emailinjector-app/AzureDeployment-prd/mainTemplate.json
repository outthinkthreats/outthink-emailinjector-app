{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appServiceName": {
      "type": "string",
      "metadata": {
        "description": "Globally unique name for the App Service."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for deploying the App Service and related resources."
      }
    },
    "sku": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": [
        "B1",
        "B2",
        "S1",
        "S2"
      ],
      "metadata": {
        "description": "App Service Plan pricing tier (SKU)."
      }
    },
    "keyVaultUrl": {
      "type": "string",
      "metadata": {
        "description": "URL of the Azure Key Vault to be used by the application."
      }
    },
    "apiBaseUrl": {
      "type": "string",
      "metadata": {
        "description": "Base URL for the email injector API based on selected region."
      }
    },
    "artifactsLocation": {
      "type": "string",
      "defaultValue": "[if(contains(deployment().properties, 'templateLink'), substring(deployment().properties.templateLink.uri, 0, add(lastIndexOf(deployment().properties.templateLink.uri, '/'), 1)), '')]",
      "metadata": {
        "description": "The base URI of the Managed Application artifacts."
      }
    },
    "artifactsLocationSasToken": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "(Optional) SAS token for the artifactsLocation if required."
      }
    }
  },
  "variables": {
    "appName": "[parameters('appServiceName')]",
    "planName": "[concat(parameters('appServiceName'), '-plan')]",
    "apiUrlMap": {
      "united-states": "https://api.outthink.app/dmi",
      "uae": "https://api.outthink.io/dmi",
      "europe": "https://api.outthink.io/dmi"
    },
    "resolvedApiUrl": "[variables('apiUrlMap')[parameters('apiBaseUrl')]]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2021-02-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": {
        "name": "[parameters('sku')]",
        "tier": "[if(startsWith(parameters('sku'), 'B'), 'Basic', 'Standard')]",
        "capacity": 1
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[format('{0}-ai', variables('appName'))]",
      "location": "[parameters('location')]",
      "properties": {
        "Application_Type": "web"
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2021-02-01",
      "name": "[variables('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "httpsOnly": true,
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "siteConfig": {
          "linuxFxVersion": "DOTNETCORE|8.0",
          "appCommandLine": "dotnet /home/site/wwwroot/OutThink.EmailInjectorApp.dll",
          "alwaysOn": true
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "[resourceId('Microsoft.Insights/components', format('{0}-ai', variables('appName')))]"
      ],
      "resources": [
        {
          "type": "config",
          "name": "appsettings",
          "apiVersion": "2021-02-01",
          "dependsOn": [
            "[resourceId('Microsoft.Web/sites', variables('appName'))]"
          ],
          "properties": {
            "WEBSITE_RUN_FROM_PACKAGE": "[uri(parameters('artifactsLocation'), concat('app.zip', parameters('artifactsLocationSasToken')))]",
            "ASPNETCORE_URLS": "http://0.0.0.0:8080",
            "KeyVaultUrl": "[parameters('keyVaultUrl')]",
            "ApiBaseUrl": "[variables('resolvedApiUrl')]",
            "BatchSize": "50",
            "SkipConfirmation": "false",
            "APPLICATIONINSIGHTS_CONNECTION_STRING": "[reference(resourceId('Microsoft.Insights/components', format('{0}-ai', variables('appName'))), '2020-02-02').ConnectionString]"
          }
        }
      ]
    }
  ],
  "outputs": {
    "appServiceName": {
      "type": "string",
      "value": "[parameters('appServiceName')]"
    },
    "appServicePlanName": {
      "type": "string",
      "value": "[variables('planName')]"
    },
    "webAppUrl": {
      "type": "string",
      "value": "[format('https://{0}.azurewebsites.net', variables('appName'))]"
    },
    "identityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', variables('appName')), '2021-02-01', 'Full').identity.principalId]"
    }
  }
}
